generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DictionaryStatus {
  uploaded
  queued
  importing
  ready
  failed
}

enum ImportJobStatus {
  queued
  running
  completed
  failed
}

enum EntryKind {
  definition
  redirect
  unknown
}

enum ContentModel {
  html
  structured
}

enum ContentBlockKind {
  definition
  example
  annotation
  section
  subdivision
  raw
}

enum ContentAnnotationKind {
  note
  grammar
  orthography
  usage
  caution
  expression
  etymology
  derivative
  other
}

enum ContentTextRole {
  source
  translation
  transliteration
  definition
  label
  body
  other
}

model Dictionary {
  id                             String            @id @default(uuid()) @db.Uuid
  name                           String
  sourceFilename                 String            @map("source_filename")
  fileChecksum                   String            @map("file_checksum")
  storageKey                     String            @unique @map("storage_key")
  status                         DictionaryStatus  @default(uploaded)
  mdxFormatVersion               String?           @map("mdx_format_version")
  sourceEncoding                 String?           @map("source_encoding")
  headerMetadata                 Json?             @map("header_metadata")
  parserName                     String?           @map("parser_name")
  parserVersion                  String?           @map("parser_version")
  entryCount                     Int?              @map("entry_count")
  failureSummary                 String?           @map("failure_summary")
  createdAt                      DateTime          @default(now()) @map("created_at")
  importedAt                     DateTime?         @map("imported_at")
  stylesheetUrl                  String?           @map("stylesheet_url")
  stylesheetCompatibilityProfile String?           @map("stylesheet_compatibility_profile")
  packageStorageKey              String?           @map("package_storage_key")
  sourceFormat                   String            @default("mdx") @map("source_format")
  sourceLanguage                 String?           @map("source_language")
  targetLanguages                String[]          @default([]) @map("target_languages")
  contentModel                   ContentModel      @default(html) @map("content_model")
  sourceMetadata                 Json?             @map("source_metadata")
  entries                        DictionaryEntry[]
  importJobs                     ImportJob[]

  @@index([status])
  @@map("dictionaries")
}

model DictionaryEntry {
  id                          String           @id @default(uuid()) @db.Uuid
  dictionaryId                String           @map("dictionary_id") @db.Uuid
  headwordOriginal            String           @map("headword_original")
  headwordNormalized          String           @map("headword_normalized")
  sortKey                     String           @map("sort_key")
  entryRaw                    String?          @map("entry_raw")
  entrySanitizedHtml          String?          @map("entry_sanitized_html")
  entryPlainText              String           @map("entry_plain_text")
  entryKind                   EntryKind        @default(definition) @map("entry_kind")
  redirectTargetOriginal      String?          @map("redirect_target_original")
  sourceOrdinal               Int              @map("source_ordinal")
  /// Stable entry identifier assigned by the import source, scoped to the dictionary.
  sourceRecordId              String?          @map("source_record_id")
  mdxLocatorVersion           Int?             @map("mdx_locator_version")
  mdxLocatorFileChecksum      String?          @map("mdx_locator_file_checksum")
  mdxLocatorKeyText           String?          @map("mdx_locator_key_text")
  mdxLocatorKeyBlockIndex     Int?             @map("mdx_locator_key_block_index")
  mdxLocatorRecordStartOffset BigInt?          @map("mdx_locator_record_start_offset")
  mdxLocatorRecordEndOffset   BigInt?          @map("mdx_locator_record_end_offset")
  createdAt                   DateTime         @default(now()) @map("created_at")
  dictionary                  Dictionary       @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  structuredEntry             StructuredEntry?
  vocabularyItem              VocabularyItem?
  sourceArtifacts             EntrySourceArtifact[]

  @@unique([dictionaryId, sourceOrdinal])
  @@unique([dictionaryId, sourceRecordId])
  @@index([dictionaryId, headwordNormalized])
  @@index([dictionaryId, headwordNormalized(ops: raw("text_pattern_ops"))], map: "dictionary_entries_dictionary_headword_pattern_idx")
  @@index([dictionaryId, sortKey])
  @@map("dictionary_entries")
}

model StructuredEntry {
  entryId          String            @id @map("entry_id") @db.Uuid
  entry            DictionaryEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  forms            Form[]
  senses           Sense[]
  entryDefinitions EntryDefinition[]
  examples         Example[]
  contentBlocks    ContentBlock[]

  @@map("structured_entries")
}

model Form {
  id                String          @id @default(uuid()) @db.Uuid
  structuredEntryId String          @map("structured_entry_id") @db.Uuid
  text              String
  normalizedText    String          @map("normalized_text")
  language          String
  kind              String?
  tags              String[]        @default([])
  priorityTags      String[]        @default([]) @map("priority_tags")
  restrictions      String[]        @default([])
  ordinal           Int
  structuredEntry   StructuredEntry @relation(fields: [structuredEntryId], references: [entryId], onDelete: Cascade)

  @@unique([structuredEntryId, ordinal])
  @@index([normalizedText])
  @@index([normalizedText(ops: raw("text_pattern_ops"))], map: "structured_forms_normalized_text_pattern_idx")
  @@map("structured_forms")
}

model Sense {
  id                 String            @id @default(uuid()) @db.Uuid
  structuredEntryId  String            @map("structured_entry_id") @db.Uuid
  ordinal            Int
  /// Snapshot-local zero-based source position; this is not a stable source sense ID.
  sourceSenseOrdinal Int?              @map("source_sense_ordinal")
  partOfSpeech       String[]          @default([]) @map("part_of_speech")
  domains            String[]          @default([])
  tags               String[]          @default([])
  notes              String?
  structuredEntry    StructuredEntry   @relation(fields: [structuredEntryId], references: [entryId], onDelete: Cascade)
  senseDefinitions   SenseDefinition[]
  examples           Example[]
  contentBlocks      ContentBlock[]

  @@unique([structuredEntryId, ordinal])
  @@unique([structuredEntryId, sourceSenseOrdinal], map: "structured_senses_entry_source_ordinal_key")
  @@unique([structuredEntryId, id], map: "structured_senses_entry_id_key")
  @@map("structured_senses")
}

model Example {
  id                String          @id @default(uuid()) @db.Uuid
  structuredEntryId String          @map("structured_entry_id") @db.Uuid
  senseId           String?         @map("sense_id") @db.Uuid
  ordinal           Int
  source            String
  provenance        Json?
  contentBlockId    String?         @map("content_block_id") @db.Uuid
  structuredEntry   StructuredEntry @relation(fields: [structuredEntryId], references: [entryId], onDelete: Cascade)
  sense             Sense?          @relation(fields: [structuredEntryId, senseId], references: [structuredEntryId, id], onDelete: Restrict, map: "structured_examples_entry_sense_fkey")
  contentBlock      ContentBlock?   @relation(fields: [structuredEntryId, contentBlockId], references: [structuredEntryId, id], onDelete: Restrict, map: "structured_examples_entry_content_block_fkey")
  texts             ExampleText[]

  @@unique([structuredEntryId, ordinal], map: "structured_examples_entry_ordinal_key")
  @@unique([structuredEntryId, contentBlockId], map: "structured_examples_entry_content_block_key")
  @@index([senseId])
  @@map("structured_examples")
}

model ExampleText {
  id         String          @id @default(uuid()) @db.Uuid
  exampleId  String          @map("example_id") @db.Uuid
  language   String?
  role       ContentTextRole
  text       String
  ordinal    Int
  source     String
  provenance Json?
  example    Example         @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@unique([exampleId, ordinal])
  @@index([language])
  @@map("structured_example_texts")
}

model ContentBlock {
  id                String                 @id @default(uuid()) @db.Uuid
  structuredEntryId String                 @map("structured_entry_id") @db.Uuid
  parentBlockId     String?                @map("parent_block_id") @db.Uuid
  senseId           String?                @map("sense_id") @db.Uuid
  kind              ContentBlockKind
  annotationKind    ContentAnnotationKind? @map("annotation_kind")
  ordinal           Int
  source            String
  provenance        Json?
  structuredEntry   StructuredEntry        @relation(fields: [structuredEntryId], references: [entryId], onDelete: Cascade)
  sense             Sense?                 @relation(fields: [structuredEntryId, senseId], references: [structuredEntryId, id], onDelete: Restrict, map: "structured_content_blocks_entry_sense_fkey")
  parent            ContentBlock?          @relation("ContentBlockChildren", fields: [structuredEntryId, parentBlockId], references: [structuredEntryId, id], onDelete: Restrict, map: "structured_content_blocks_entry_parent_fkey")
  children          ContentBlock[]         @relation("ContentBlockChildren")
  example           Example?
  texts             ContentText[]

  @@unique([structuredEntryId, id], map: "structured_content_blocks_entry_id_key")
  @@index([structuredEntryId, parentBlockId, ordinal], map: "structured_content_blocks_entry_parent_ordinal_idx")
  @@index([senseId])
  @@map("structured_content_blocks")
}

model ContentText {
  id             String          @id @default(uuid()) @db.Uuid
  contentBlockId String          @map("content_block_id") @db.Uuid
  language       String?
  role           ContentTextRole
  text           String
  ordinal        Int
  source         String
  provenance     Json?
  contentBlock   ContentBlock    @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@unique([contentBlockId, ordinal], map: "structured_content_texts_block_ordinal_key")
  @@index([language])
  @@map("structured_content_texts")
}

model EntrySourceArtifact {
  id                    String          @id @default(uuid()) @db.Uuid
  entryId               String          @map("entry_id") @db.Uuid
  sourceFormat          String          @map("source_format")
  sourceIdentity        Json            @map("source_identity")
  parserName            String          @map("parser_name")
  parserVersion         String          @map("parser_version")
  representationVersion Int             @map("representation_version")
  rawPayload            String?         @map("raw_payload")
  rawPayloadBytes       Bytes?          @map("raw_payload_bytes")
  parsedRepresentation  Json?           @map("parsed_representation")
  diagnostics           Json?
  sourceMetadata        Json?           @map("source_metadata")
  contentChecksum       String          @map("content_checksum")
  createdAt             DateTime        @default(now()) @map("created_at")
  entry                 DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, parserName, parserVersion, representationVersion, contentChecksum], map: "entry_source_artifacts_version_key")
  @@index([sourceFormat])
  @@map("entry_source_artifacts")
}

model EntryDefinition {
  id                String          @id @default(uuid()) @db.Uuid
  structuredEntryId String          @map("structured_entry_id") @db.Uuid
  text              String
  language          String
  source            String
  provenance        Json?
  ordinal           Int
  structuredEntry   StructuredEntry @relation(fields: [structuredEntryId], references: [entryId], onDelete: Cascade)

  @@unique([structuredEntryId, language, source, ordinal], map: "entry_definitions_parent_language_source_ordinal_key")
  @@index([language])
  @@map("structured_entry_definitions")
}

model SenseDefinition {
  id         String @id @default(uuid()) @db.Uuid
  senseId    String @map("sense_id") @db.Uuid
  text       String
  language   String
  source     String
  provenance Json?
  ordinal    Int
  sense      Sense  @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([senseId, language, source, ordinal], map: "sense_definitions_parent_language_source_ordinal_key")
  @@index([language])
  @@map("structured_sense_definitions")
}

model VocabularyItem {
  id        String          @id @default(uuid()) @db.Uuid
  entryId   String          @unique @map("entry_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  entry     DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("vocabulary_items")
}

model ImportJob {
  id              String          @id @default(uuid()) @db.Uuid
  dictionaryId    String          @map("dictionary_id") @db.Uuid
  status          ImportJobStatus @default(queued)
  attemptCount    Int             @default(0) @map("attempt_count")
  claimedBy       String?         @map("claimed_by")
  claimedAt       DateTime?       @map("claimed_at")
  progressCurrent Int             @default(0) @map("progress_current")
  progressTotal   Int?            @map("progress_total")
  errorDetail     String?         @map("error_detail")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")
  dictionary      Dictionary      @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("import_jobs")
}
