{
  "manifest_version": 3,
  "name": "MDX Vocabulary Lookup",
  "version": "0.1.0",
  "description": "Look up selected English words with a local mdx-vocabulary backend.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "MDX Vocabulary Lookup settings"
  }
}
